    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "release-it": "21.1.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.6"
